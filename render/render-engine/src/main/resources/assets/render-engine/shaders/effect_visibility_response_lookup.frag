  if(group==0)backgroundSum+=dot(bg.rgb,vec3(.2126,.7152,.0722))*bg.a;
 }
 float cost=costs[0]/max(totals[0],.000001)+settings.weights.x*costs[1]/max(totals[1],.000001)+.000001*logGain*logGain;
 result=vec4(cost,contrasts[0]/max(totals[0],.000001),contrasts[1]/max(totals[1],.000001),safe);
}
